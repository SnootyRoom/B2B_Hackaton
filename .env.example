DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo12345
LLM_BASE_URL=                      # базовый URL из личного кабинета ProxyAPI
LLM_API_KEY=                       # пусто → режим без LLM
LLM_MODEL=                         # точный идентификатор модели в ProxyAPI
DADATA_API_KEY=                    # пусто → только кэш и офлайн-профили
EGRUL_CACHE_TTL_DAYS=7
UPLOAD_MAX_FILE_MB=20
UPLOAD_MAX_ARCHIVE_MB=100
UPLOAD_MAX_FILES=500
