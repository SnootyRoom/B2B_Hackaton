DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo12345
# Комментарии — только отдельной строкой: docker-compose считает текст после = значением
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Секретная часть API-ключа Yandex Cloud; пусто → режим без LLM
LLM_API_KEY=
# Идентификатор каталога Yandex Cloud
LLM_FOLDER_ID=
LLM_MODEL=yandexgpt/latest
# Пусто → только кэш и офлайн-профили
DADATA_API_KEY=
EGRUL_CACHE_TTL_DAYS=7
UPLOAD_MAX_FILE_MB=20
UPLOAD_MAX_ARCHIVE_MB=100
UPLOAD_MAX_FILES=500
